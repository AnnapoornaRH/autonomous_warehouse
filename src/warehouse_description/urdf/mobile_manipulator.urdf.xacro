<?xml version="1.0"?>
<!--
  Differential-drive mobile manipulator for the autonomous warehouse.

    * 2 driven wheels + 2 frictionless casters (Gazebo DiffDrive plugin)
    * front-nose 2D LiDAR at chassis height (sees shelves, walls and other robots)
    * 4-DOF arm (yaw, shoulder, elbow, wrist pitch) + 2-finger parallel gripper
      driven by gz-sim JointPositionController plugins
    * front camera, joint state publisher, chassis contact sensor

  base_link origin: on the ground, below the centre of the chassis.

  xacro args:  robot_name   namespace / gz model name (also used in gz topic names)
               robot_color  "r g b a" body colour
               use_camera   "true" / "false"
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobile_manipulator">
  <xacro:arg name="robot_name" default="robot1"/>
  <xacro:arg name="robot_color" default="0.13 0.83 0.93 1"/>
  <xacro:arg name="use_camera" default="true"/>

  <xacro:property name="rn" value="$(arg robot_name)"/>
  <xacro:property name="pi" value="3.14159265358979"/>

  <!-- chassis -->
  <xacro:property name="ch_x" value="0.50"/>
  <xacro:property name="ch_y" value="0.36"/>
  <xacro:property name="ch_z" value="0.12"/>
  <xacro:property name="ch_zc" value="0.14"/>   <!-- chassis centre height -->
  <xacro:property name="wheel_r" value="0.08"/>
  <xacro:property name="wheel_w" value="0.04"/>
  <xacro:property name="wheel_y" value="0.20"/>
  <!-- arm -->
  <xacro:property name="arm_x" value="0.05"/>
  <xacro:property name="L1" value="0.26"/>
  <xacro:property name="L2" value="0.26"/>

  <material name="body"><color rgba="$(arg robot_color)"/></material>
  <material name="dark"><color rgba="0.12 0.13 0.15 1"/></material>
  <material name="steel"><color rgba="0.70 0.72 0.76 1"/></material>
  <material name="orange"><color rgba="0.95 0.55 0.10 1"/></material>

  <xacro:macro name="box_inertial" params="m x y z xyz:='0 0 0'">
    <inertial><origin xyz="${xyz}" rpy="0 0 0"/><mass value="${m}"/>
      <inertia ixx="${m/12.0*(y*y+z*z)}" iyy="${m/12.0*(x*x+z*z)}" izz="${m/12.0*(x*x+y*y)}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <!-- ===================== base ===================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.12" rpy="0 0 0"/><mass value="9.0"/>
      <inertia ixx="0.16" iyy="0.20" izz="0.30" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual name="chassis_visual">
      <origin xyz="0 0 ${ch_zc}" rpy="0 0 0"/>
      <geometry><box size="${ch_x} ${ch_y} ${ch_z}"/></geometry><material name="body"/>
    </visual>
    <visual name="deck_visual">
      <origin xyz="0 0 0.205" rpy="0 0 0"/>
      <geometry><box size="${ch_x-0.04} ${ch_y-0.04} 0.012"/></geometry><material name="dark"/>
    </visual>
    <!-- collision box is slightly wider than the body so that it also covers the wheels -->
    <collision name="chassis_collision">
      <origin xyz="0 0 ${ch_zc}" rpy="0 0 0"/>
      <geometry><box size="${ch_x} 0.44 ${ch_z}"/></geometry>
    </collision>
  </link>

  <!-- wheels -->
  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel">
      <inertial><origin xyz="0 0 0" rpy="${pi/2} 0 0"/><mass value="0.5"/>
        <inertia ixx="0.0014" iyy="0.0014" izz="0.0016" ixy="0" ixz="0" iyz="0"/></inertial>
      <visual><origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry><material name="dark"/></visual>
      <collision name="${side}_wheel_collision"><origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry></collision>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${side}_wheel"/>
      <origin xyz="0 ${y} ${wheel_r}" rpy="0 0 0"/><axis xyz="0 1 0"/>
      <dynamics damping="0.02" friction="0.0"/>
    </joint>
    <gazebo reference="${side}_wheel">
      <mu1>1.6</mu1><mu2>1.6</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:wheel side="left" y="${wheel_y}"/>
  <xacro:wheel side="right" y="${-wheel_y}"/>

  <!-- casters -->
  <xacro:macro name="caster" params="name x">
    <link name="${name}">
      <inertial><mass value="0.1"/><inertia ixx="0.00004" iyy="0.00004" izz="0.00004" ixy="0" ixz="0" iyz="0"/></inertial>
      <visual><geometry><sphere radius="0.04"/></geometry><material name="steel"/></visual>
      <collision name="${name}_collision"><geometry><sphere radius="0.04"/></geometry></collision>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/><child link="${name}"/><origin xyz="${x} 0 0.04" rpy="0 0 0"/>
    </joint>
    <gazebo reference="${name}"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  </xacro:macro>
  <xacro:caster name="front_caster" x="0.20"/>
  <xacro:caster name="rear_caster" x="-0.20"/>

  <!-- ===================== sensors ===================== -->
  <link name="lidar_link">
    <inertial><mass value="0.15"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="-0.01 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.035" length="0.06"/></geometry>
      <material name="dark"/></visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/><origin xyz="0.25 0 0.14" rpy="0 0 0"/>
  </joint>

  <!-- rear LiDAR (looks backwards): together with the nose LiDAR the robot sees 352 deg, so other robots are
       detected from every side. Used by the costmaps and the reverse safety stop, not by AMCL. -->
  <link name="lidar_rear_link">
    <inertial><mass value="0.15"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0.01 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.035" length="0.06"/></geometry>
      <material name="dark"/></visual>
  </link>
  <joint name="lidar_rear_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_rear_link"/><origin xyz="-0.25 0 0.14" rpy="0 0 ${pi}"/>
  </joint>

  <xacro:if value="$(arg use_camera)">
    <link name="camera_link">
      <inertial><mass value="0.05"/><inertia ixx="0.00001" iyy="0.00001" izz="0.00001" ixy="0" ixz="0" iyz="0"/></inertial>
      <visual><geometry><box size="0.03 0.07 0.03"/></geometry><material name="dark"/></visual>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent link="base_link"/><child link="camera_link"/><origin xyz="0.235 0 0.235" rpy="0 0.15 0"/>
    </joint>
  </xacro:if>

  <!-- ===================== arm ===================== -->
  <link name="arm_base_link">
    <inertial><mass value="0.3"/><inertia ixx="0.0003" iyy="0.0003" izz="0.0003" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.02" rpy="0 0 0"/><geometry><cylinder radius="0.055" length="0.04"/></geometry>
      <material name="steel"/></visual>
  </link>
  <joint name="arm_base_joint" type="fixed">
    <parent link="base_link"/><child link="arm_base_link"/><origin xyz="${arm_x} 0 0.21" rpy="0 0 0"/>
  </joint>

  <!-- joint1: turret yaw -->
  <link name="arm_link1">
    <inertial><origin xyz="0 0 0.03" rpy="0 0 0"/><mass value="0.4"/>
      <inertia ixx="0.0008" iyy="0.0008" izz="0.0004" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.03" rpy="0 0 0"/><geometry><cylinder radius="0.045" length="0.06"/></geometry>
      <material name="orange"/></visual>
    <collision name="turret_collision"><origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.06"/></geometry></collision>
  </link>
  <joint name="arm_joint1" type="revolute">
    <parent link="arm_base_link"/><child link="arm_link1"/><origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/><limit lower="-1.8" upper="1.8" effort="30" velocity="2.0"/>
    <dynamics damping="1.0" friction="0.0"/>
  </joint>

  <!-- joint2: shoulder pitch (positive = tilt forward) ; links extend along local +z -->
  <link name="arm_link2">
    <inertial><origin xyz="0 0 ${L1/2}" rpy="0 0 0"/><mass value="0.5"/>
      <inertia ixx="0.003" iyy="0.003" izz="0.0003" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 ${L1/2}" rpy="0 0 0"/><geometry><box size="0.05 0.05 ${L1}"/></geometry>
      <material name="body"/></visual>
    <visual><origin xyz="0 0 0" rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.035" length="0.07"/></geometry>
      <material name="orange"/></visual>
    <collision name="upper_arm_collision"><origin xyz="0 0 ${L1/2}" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 ${L1}"/></geometry></collision>
  </link>
  <joint name="arm_joint2" type="revolute">
    <parent link="arm_link1"/><child link="arm_link2"/><origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 1 0"/><limit lower="-1.5" upper="1.8" effort="40" velocity="1.5"/>
    <dynamics damping="1.5" friction="0.0"/>
  </joint>

  <!-- joint3: elbow -->
  <link name="arm_link3">
    <inertial><origin xyz="0 0 ${L2/2}" rpy="0 0 0"/><mass value="0.4"/>
      <inertia ixx="0.0024" iyy="0.0024" izz="0.0003" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 ${L2/2}" rpy="0 0 0"/><geometry><box size="0.045 0.045 ${L2}"/></geometry>
      <material name="steel"/></visual>
    <visual><origin xyz="0 0 0" rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.032" length="0.065"/></geometry>
      <material name="orange"/></visual>
    <collision name="forearm_collision"><origin xyz="0 0 ${L2/2}" rpy="0 0 0"/>
      <geometry><box size="0.045 0.045 ${L2}"/></geometry></collision>
  </link>
  <joint name="arm_joint3" type="revolute">
    <parent link="arm_link2"/><child link="arm_link3"/><origin xyz="0 0 ${L1}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/><limit lower="-0.5" upper="2.9" effort="30" velocity="1.5"/>
    <dynamics damping="1.0" friction="0.0"/>
  </joint>

  <!-- joint4: wrist pitch -->
  <link name="wrist_link">
    <inertial><origin xyz="0 0 0.03" rpy="0 0 0"/><mass value="0.25"/>
      <inertia ixx="0.0003" iyy="0.0003" izz="0.0002" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0" rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.028" length="0.06"/></geometry>
      <material name="orange"/></visual>
    <visual><origin xyz="0 0 0.03" rpy="0 0 0"/><geometry><box size="0.05 0.07 0.04"/></geometry>
      <material name="dark"/></visual>
  </link>
  <joint name="arm_joint4" type="revolute">
    <parent link="arm_link3"/><child link="wrist_link"/><origin xyz="0 0 ${L2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/><limit lower="-2.2" upper="2.2" effort="10" velocity="2.0"/>
    <dynamics damping="0.4" friction="0.0"/>
  </joint>

  <!-- gripper: palm + 2 prismatic fingers closing along the hand's y axis.
       Hand +z points along the arm, i.e. forward when the wrist is level. -->
  <link name="gripper_link">
    <inertial><origin xyz="0 0 0.015" rpy="0 0 0"/><mass value="0.2"/>
      <inertia ixx="0.0002" iyy="0.0002" izz="0.0002" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.015" rpy="0 0 0"/><geometry><box size="0.06 0.20 0.03"/></geometry>
      <material name="dark"/></visual>
    <collision name="palm_collision"><origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry><box size="0.06 0.20 0.03"/></geometry></collision>
  </link>
  <joint name="gripper_joint" type="fixed">
    <parent link="wrist_link"/><child link="gripper_link"/><origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="finger" params="side sign">
    <link name="finger_${side}">
      <inertial><origin xyz="0 0 0.04" rpy="0 0 0"/><mass value="0.05"/>
        <inertia ixx="0.00003" iyy="0.00003" izz="0.00001" ixy="0" ixz="0" iyz="0"/></inertial>
      <visual><origin xyz="0 0 0.0425" rpy="0 0 0"/><geometry><box size="0.04 0.016 0.085"/></geometry>
        <material name="orange"/></visual>
      <collision name="finger_${side}_collision"><origin xyz="0 0 0.0425" rpy="0 0 0"/>
        <geometry><box size="0.04 0.016 0.085"/></geometry></collision>
    </link>
    <!-- q = 0 : closed (inner faces touch) ;  q = 0.07 : open (14 cm gap, generous for a 6 cm item) -->
    <joint name="finger_${side}_joint" type="prismatic">
      <parent link="gripper_link"/><child link="finger_${side}"/>
      <origin xyz="0 ${sign*0.008} 0.03" rpy="0 0 0"/>
      <axis xyz="0 ${sign} 0"/><limit lower="0.0" upper="0.07" effort="40" velocity="0.2"/>
      <dynamics damping="2.0" friction="0.0"/>
    </joint>
    <gazebo reference="finger_${side}"><mu1>3.0</mu1><mu2>3.0</mu2></gazebo>
  </xacro:macro>
  <xacro:finger side="left" sign="1"/>
  <xacro:finger side="right" sign="-1"/>

  <!-- ===================== Gazebo (gz-sim) ===================== -->
  <gazebo reference="base_link"><mu1>0.2</mu1><mu2>0.2</mu2></gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${2*wheel_y}</wheel_separation>
      <wheel_radius>${wheel_r}</wheel_radius>
      <max_linear_velocity>0.8</max_linear_velocity>
      <min_linear_velocity>-0.8</min_linear_velocity>
      <max_angular_velocity>1.6</max_angular_velocity>
      <min_angular_velocity>-1.6</min_angular_velocity>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.5</max_angular_acceleration>
      <min_angular_acceleration>-2.5</min_angular_acceleration>
      <topic>/model/${rn}/cmd_vel</topic>
      <odom_topic>/model/${rn}/odometry</odom_topic>
      <tf_topic>/model/${rn}/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>20</odom_publish_frequency>
    </plugin>

    <!-- ground-truth model pose (used by the dashboard, metrics and pick verification) -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>false</static_publisher>
      <update_frequency>10</update_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/model/${rn}/joint_states</topic>
    </plugin>

    <!-- arm and gripper joint position controllers (one per joint) -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>arm_joint1</joint_name><topic>/model/${rn}/arm/joint1/cmd_pos</topic>
      <p_gain>100</p_gain><i_gain>0</i_gain><d_gain>10</d_gain>
      <cmd_max>30</cmd_max><cmd_min>-30</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>arm_joint2</joint_name><topic>/model/${rn}/arm/joint2/cmd_pos</topic>
      <p_gain>260</p_gain><i_gain>0</i_gain><d_gain>20</d_gain>
      <cmd_max>40</cmd_max><cmd_min>-40</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>arm_joint3</joint_name><topic>/model/${rn}/arm/joint3/cmd_pos</topic>
      <p_gain>200</p_gain><i_gain>0</i_gain><d_gain>14</d_gain>
      <cmd_max>30</cmd_max><cmd_min>-30</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>arm_joint4</joint_name><topic>/model/${rn}/arm/joint4/cmd_pos</topic>
      <p_gain>60</p_gain><i_gain>0</i_gain><d_gain>3</d_gain>
      <cmd_max>10</cmd_max><cmd_min>-10</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>finger_left_joint</joint_name><topic>/model/${rn}/gripper/left/cmd_pos</topic>
      <p_gain>1500</p_gain><i_gain>0</i_gain><d_gain>40</d_gain>
      <cmd_max>40</cmd_max><cmd_min>-40</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>finger_right_joint</joint_name><topic>/model/${rn}/gripper/right/cmd_pos</topic>
      <p_gain>1500</p_gain><i_gain>0</i_gain><d_gain>40</d_gain>
      <cmd_max>40</cmd_max><cmd_min>-40</cmd_min>
    </plugin>
  </gazebo>

  <!-- 2D LiDAR (nose, chassis height, 176 deg field of view) -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/model/${rn}/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>177</samples><resolution>1</resolution>
            <min_angle>-1.5359</min_angle><max_angle>1.5359</max_angle>
          </horizontal>
        </scan>
        <range><min>0.12</min><max>6.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.004</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_rear_link">
    <sensor name="lidar_rear" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/model/${rn}/scan_rear</topic>
      <gz_frame_id>lidar_rear_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>177</samples><resolution>1</resolution>
            <min_angle>-1.5359</min_angle><max_angle>1.5359</max_angle>
          </horizontal>
        </scan>
        <range><min>0.12</min><max>6.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.004</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>

  <xacro:if value="$(arg use_camera)">
    <gazebo reference="camera_link">
      <sensor name="camera" type="camera">
        <topic>/model/${rn}/camera/image</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <update_rate>5</update_rate>
        <always_on>true</always_on>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image><width>320</width><height>240</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>10</far></clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- chassis contact sensor: used to count real collisions -->
  <gazebo reference="base_link">
    <sensor name="chassis_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <topic>/model/${rn}/contact</topic>
      <!-- sdformat renames lumped collisions: <link>_fixed_joint_lump__<name>_collision -->
      <contact><collision>base_link_fixed_joint_lump__chassis_collision_collision</collision></contact>
    </sensor>
  </gazebo>
</robot>
