  <version>1.0.0</version>
  <description>Gazebo world, ros_gz bridges, simulation services (ground truth, collisions, items, sim control)</description>
  <maintainer email="warehouse@example.com">warehouse</maintainer>
  <license>Apache-2.0</license>
  <depend>warehouse_common</depend>
  <depend>warehouse_description</depend>
  <depend>warehouse_robot_interfaces</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>ros_gz_interfaces</depend>
  <depend>tf2_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
